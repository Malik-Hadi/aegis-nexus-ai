# Copy to .env and change the values. NEVER commit .env.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=aegis
POSTGRES_PORT=5432
DATABASE_URL=postgres://aegis:change-me-now@localhost:5432/aegis?sslmode=disable
API_ADDR=127.0.0.1:8080
API_TLS_CERT=
API_TLS_KEY=
SESSION_SECRET=change-me-to-a-long-random-string
ENROLMENT_TOKEN=change-me-one-time-lab-token
# Optional. Leave empty to use the offline AI fallback.
LLM_API_KEY=

# Optional HTTPS incident analysis adapter. Leave blank for offline mode.
SOC_ANALYST_URL=
SOC_ANALYST_TOKEN=

# Inbound request inspection: block (default), monitor (log only) or off
INSPECT_MODE=block
