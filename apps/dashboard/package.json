{
  "name": "aegis-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "AEGIS NEXUS AI SOC console with a same-origin Go API gateway",
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "start": "next start --hostname localhost",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "playwright": "1.65.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
